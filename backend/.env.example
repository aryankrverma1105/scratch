# Sologix Energy Attendance & GPS Tracking System - Environment Configuration
# Node.js / Express Backend

PORT=5050
NODE_ENV=production

# Security - JWT secret MUST be at least 32 characters long in production
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=12h

# Company Configuration & Localization
COMPANY_TZ=Asia/Kolkata
AUTO_CHECKOUT_TIME=21:00
NO_SIGNAL_THRESHOLD_MINUTES=5

# Database Configuration (Leave blank for SQLite in ./data/attendance.db)
# For PostgreSQL: DATABASE_URL=postgres://attendance_user:your_secure_password@127.0.0.1:5432/attendance_db
DATABASE_URL=

# Firebase Cloud Messaging (FCM) for Admin Push Notifications (Optional)
# FIREBASE_SERVICE_ACCOUNT_KEY=./config/firebase-adminsdk.json
